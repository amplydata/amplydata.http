### Autenticar
POST {{baseUrl}}/v1/auth
Accept: application/json
Content-Type: application/json

{
  "email": "{{username}}",
  "password": "{{password}}"
}

> {%
    const data = response.body;

    client.global.set("token", data.token);
%}

### Esqueci minha senha
POST {{baseUrl}}/v1/auth/forgot
Accept: application/json
Content-Type: application/json

{
  "email": "{{username}}"
}

### Solicitar Pin
POST {{baseUrl}}/v1/auth/pin
Accept: application/json
Content-Type: application/json

{
  "email": "{{username}}"
}

### Alterar senha com Pin
PUT {{baseUrl}}/v1/auth/changepasswordwithpin
Accept: application/json
Content-Type: application/json

{
  "email": "{{username}}",
  "pin": "{{pin}}",
  "password": "{{newPassword}}"
}

### Validar Token
POST {{baseUrl}}/v1/auth/valid
Accept: application/json
Content-Type: application/json

{
  "token": "{{token}}"
}
